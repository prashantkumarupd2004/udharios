; ============================================================
; Ugaahi TDL Addon — Ledger Master with Phone Numbers
; ============================================================
; Tally ke ANDAR chalta hai — saare fields accessible!
;
; Load: F12 → Product & Features → F4 → ugaahi.tdl select → Restart
; Agent phir "Ugaahi Ledger Export" collection ko query karega.
; ============================================================

[Collection: Ugaahi Ledger Export]
  Type            : Ledger
  Fetch           : Name, Parent, ClosingBalance
  Compute         : UgaahiPhone : $LedgerPhone
  Compute         : UgaahiMobile : $Mobile
  Filter          : UgaahiPartyFilter

[System: Formulae: UgaahiPartyFilter]
  Formula : $Parent contains "Sundry Debtors" or $Parent contains "Sundry Creditors"
